@model SeguimientoDocumentoViewModel

@{
    ViewData["Title"] = "Seguimiento de Documentos";
}

<h1>📑 Seguimiento de Documentos</h1>

<form asp-action="Seguimiento" method="post">
    <div class="form-floating mt-4 mb-3 col-md-6">
        <select asp-for="IdDocumento" asp-items="Model.Documentos" class="form-select">
            <option value="">-- Seleccione un documento --</option>
        </select>
        <label asp-for="IdDocumento" class="form-label"></label>
        <span asp-validation-for="IdDocumento" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-outline-primary">🔍 Buscar</button>
</form>

@if (ViewBag.InfoMensaje != null)
{
    <div class="alert alert-info mt-4 col-md-6">
        @ViewBag.InfoMensaje
    </div>
}

@if (Model.Historial?.Any() == true)
{
    <div class="table-responsive mt-4">
        <table class="table table-striped table-hover align-middle" style="font-size: small;">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Documento</th>
                    <th>Acción</th>
                    <th>Origen</th>
                    <th>Destino</th>
                    <th>Estado Doc</th>
                    <th>Observaciones</th>
                    <th>Avance</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Historial)
                {
                    <tr>
                        <td>@(item.FechaMovimiento?.ToString("dd/MM/yyyy HH:mm:ss"))</td>
                        <td>@item.Documento</td>
                        <td>
                            <span class="badge @(item.Accion == "creado" ? "bg-secondary" : item.Accion == "enviado" ? "bg-warning text-dark" : "bg-primary")">
                                @item.Accion
                            </span>
                        </td>
                        <td>@(item.UsuarioOrigenNombre ?? "-")</td>
                        <td>@(item.UsuarioDestinoNombre ?? "-")</td>
                        <td>@item.Estado</td>
                        <td>@item.Observaciones</td>
                        <td>@item.Avance%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
