@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="row justify-content-center mb-4">
    <div class="col-sm-6 col-md-4 col-lg-3">
        <a asp-controller="Documento" asp-action="Recibir" class="text-decoration-none">
            <div class="card shadow-sm h-100 border-danger">
                <div class="card-body text-center text-danger">
                    <i class="bi bi-bell-fill fs-1"></i>
                    <h5 class="card-title mt-3">@Model.Pendientes Pendientes por recibir</h5>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 justify-content-center">
    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-clipboard2-check-fill text-primary fs-1"></i>
                <h5 class="card-title mt-3">Documentos @Model.TotalDocumentos</h5>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-send-fill fs-1" style="color: #FF8C00;"></i>
                <h5 class="card-title mt-3">Enviados @Model.TotalEnvios</h5>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-envelope-fill fs-1" style="color: #663399;"></i>
                <h5 class="card-title mt-3">Recibidos @Model.TotalRecepciones</h5>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-md-4 col-lg-3">
        <div class="card shadow-sm h-100">
            <div class="card-body text-center">
                <i class="bi bi-archive-fill fs-1" style="color: #006400;"></i>
                <h5 class="card-title mt-3">Concluidos @Model.Concluidos</h5>
            </div>
        </div>
    </div>
</div>
